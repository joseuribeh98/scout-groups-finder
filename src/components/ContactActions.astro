---
import Icon from "@/components/Icon.astro";
import type { Grupo } from "@/data/schema";
import { REGION } from "@/data/region";
import type { Lang } from "@/i18n/lang";
import { translator } from "@/i18n/ui";
import type { IconName } from "@/lib/icons";
import { directionsUrl, mailtoUrl, wazeUrl, whatsappUrl } from "@/lib/contact";

interface Props {
  grupo: Grupo;
  lang: Lang;
  /** "bar": solo acción principal y cómo llegar (barra fija en móvil). */
  variant?: "full" | "bar";
}
const { grupo, lang, variant = "full" } = Astro.props;
const t = translator(lang);
const vars = { id: grupo.id, nombre: grupo.nombre };
const { email, whatsapp, instagram, facebook, web } = grupo.contacto;
const hasDirectContact = Boolean(whatsapp || email || instagram || facebook || web);

interface Action {
  key: string;
  href: string;
  label: string;
  icon: IconName;
  external: boolean;
}
const whatsappAction: Action | null = whatsapp
  ? {
      key: "whatsapp",
      href: whatsappUrl(whatsapp, t("grupo.whatsappMsg", vars)),
      label: t("grupo.whatsapp"),
      icon: "whatsapp",
      external: true,
    }
  : null;
const emailAction: Action | null = email
  ? {
      key: "email",
      href: mailtoUrl(email, t("grupo.emailSubject", vars)),
      label: t("grupo.email"),
      icon: "mail",
      external: false,
    }
  : null;
// Acción principal: WhatsApp si existe; si no, correo. El resto va como botones delineados.
const primary = whatsappAction ?? emailAction;
const secondary: Action[] = [
  ...(whatsappAction && emailAction ? [emailAction] : []),
  {
    key: "directions",
    href: directionsUrl(grupo.ubicacion),
    label: t("grupo.directions"),
    icon: "navigation",
    external: true,
  },
  {
    key: "waze",
    href: wazeUrl(grupo.ubicacion),
    label: t("grupo.waze"),
    icon: "waze",
    external: true,
  },
  ...(instagram
    ? [
        {
          key: "instagram",
          href: instagram,
          label: t("grupo.instagram"),
          icon: "instagram",
          external: true,
        } as const,
      ]
    : []),
  ...(facebook
    ? [
        {
          key: "facebook",
          href: facebook,
          label: t("grupo.facebook"),
          icon: "facebook",
          external: true,
        } as const,
      ]
    : []),
  ...(web
    ? [{ key: "web", href: web, label: t("grupo.web"), icon: "globe", external: true } as const]
    : []),
];
const base =
  "flex h-12 items-center justify-center gap-2 rounded-xl px-3 font-semibold whitespace-nowrap transition-colors";
---

{variant === "bar" ? (
  <div data-contact-bar class="flex gap-2">
    {primary && (
      <a
        class={`${base} flex-1 bg-brand text-on-brand`}
        href={primary.href}
        target={primary.external ? "_blank" : undefined}
        rel={primary.external ? "noopener noreferrer" : undefined}
        data-action={primary.key}
      >
        <Icon name={primary.icon} />
        {primary.label}
      </a>
    )}
    <a
      class={`${base} ${primary ? "" : "flex-1 "}border border-line bg-surface text-ink`}
      href={directionsUrl(grupo.ubicacion)}
      target="_blank"
      rel="noopener noreferrer"
      data-action="directions"
    >
      <Icon name="navigation" class="size-5 text-brand" />
      {t("grupo.directions")}
    </a>
  </div>
) : (
  <div class="grid gap-3">
    {primary && (
      <a
        class={`${base} bg-brand text-on-brand shadow-sm hover:bg-brand-strong`}
        href={primary.href}
        target={primary.external ? "_blank" : undefined}
        rel={primary.external ? "noopener noreferrer" : undefined}
        data-action={primary.key}
      >
        <Icon name={primary.icon} />
        {primary.label}
      </a>
    )}
    {!hasDirectContact && (
      <p class="rounded-xl border border-line bg-brand-soft p-4 text-sm">
        {t("grupo.noContact")}{" "}
        <a class="font-semibold underline" href={REGION.web} data-action="region">
          {t("grupo.contactRegion")}
        </a>
      </p>
    )}
    <ul class="grid grid-cols-2 gap-3">
      {secondary.map((a) => (
        <li>
          <a
            class={`${base} border border-line bg-surface text-ink hover:border-brand/60 hover:bg-brand-soft`}
            href={a.href}
            target={a.external ? "_blank" : undefined}
            rel={a.external ? "noopener noreferrer" : undefined}
            data-action={a.key}
          >
            <Icon name={a.icon} class="size-5 text-brand" />
            {a.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
